{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-git-add-all.mjs\"",
            "timeout": 10,
            "statusMessage": "Conferindo o estágio do git…"
          }
        ]
      }
    ]
  }
}
