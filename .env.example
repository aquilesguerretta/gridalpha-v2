# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# Vite exposes only variables prefixed with VITE_ to the browser.

# Mapbox (public token is ok in frontend; still avoid committing real tokens to git)
VITE_MAPBOX_TOKEN=
VITE_MAPBOX_STYLE=mapbox://styles/your-username/your-style-id

# Development proxy target only. Browser runtime always calls same-origin `/api/*`.
# Production routing is configured by vercel.json, not a VITE_* runtime URL.
VITE_BACKEND_URL=http://localhost:8000

# Tomorrow.io — https://app.tomorrow.io/development/keys
VITE_TOMORROW_API_KEY=

# EIA — https://www.eia.gov/opendata/register.php
VITE_EIA_API_KEY=

# ElectricityMaps — https://api.electricitymap.org
VITE_ELECTRICITY_MAPS_KEY=

# ── FastAPI gridalpha-v2 on Railway (server-side — no VITE_ prefix) ───────────
# Same service as Peregrine: https://gridalpha-v2-production.up.railway.app
# EIA_API_KEY=              # same value as VITE_EIA_API_KEY (Henry Hub + EIA routes)
# TOMORROW_API_KEY=         # same value as VITE_TOMORROW_API_KEY (weather routes)
# PJM_SUBSCRIPTION_KEY=     # Preferred: APIM key from PJM API portal (api.pjm.com)
# PJM_USERNAME=             # Fallback: PJM Tools login (SSO cookie)
# PJM_PASSWORD=             # paste in Railway UI
# Optional: PJM_SSO_AUTH_URL=https://sso.pjm.com/access/authenticate
# Optional: PJM_SESSION_COOKIE_NAME=iPlanetDirectoryPro
# Required in Railway production for direct non-proxied tools/diagnostics:
# CORS_ORIGINS=https://nivar.com.br,https://www.nivar.com.br
# ANTHROPIC_API_KEY=      # server-side only; never use a VITE_ prefix
