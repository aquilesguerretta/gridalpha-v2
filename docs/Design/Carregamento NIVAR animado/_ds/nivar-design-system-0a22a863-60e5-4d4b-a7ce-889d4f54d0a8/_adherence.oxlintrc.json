{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/charts/**",
              "components/controls/**",
              "components/data/**",
              "components/editorial/**",
              "components/errors/**",
              "components/export/**",
              "components/forms/**",
              "components/glossary/**",
              "components/labels/**",
              "components/loading/**",
              "components/navigation/**",
              "components/overlay/**",
              "components/states/**",
              "components/structure/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Zilla Slab|Work Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Zilla Slab, Work Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:modo|onModo|onSubmit|erro|registro|className|key|ref|className|style|children)$/]",
        "message": "<AuthForm> doesn't accept that prop. Declared props: modo, onModo, onSubmit, erro, registro, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthForm'] > JSXAttribute[name.name='modo'] > Literal[value!=/^(?:entrar|cadastrar)$/]",
        "message": "<AuthForm> modo must be one of 'entrar' | 'cadastrar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarraDado'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|cor|legenda|key|ref|className|style|children)$/]",
        "message": "<BarraDado> doesn't accept that prop. Declared props: label, value, cor, legenda."
