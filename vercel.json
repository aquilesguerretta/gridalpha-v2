{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "wave/nivar-g2-dream-build": false
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gridalpha-v2-production.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
